execute_process(
    COMMAND "${DUMPBIN}" /headers /dependents "${EXE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Could not inspect executable: ${error}")
endif()
string(TOLOWER "${output}" output)
if (NOT output MATCHES "8664 machine \\(x64\\)" OR NOT output MATCHES "kernel32\\.dll")
    message(FATAL_ERROR "Expected an x64 Windows executable with an import table")
endif()
string(REGEX MATCHALL "[a-z0-9_.+-]+\\.dll" imports "${output}")
set(allowed kernel32.dll user32.dll gdi32.dll winmm.dll bcrypt.dll)
foreach(dll IN LISTS imports)
    if (NOT dll IN_LIST allowed)
        message(FATAL_ERROR "Unexpected DLL import: ${dll}")
    endif()
endforeach()
foreach(dll IN LISTS allowed)
    if (NOT dll IN_LIST imports)
        message(FATAL_ERROR "Missing expected DLL import: ${dll}")
    endif()
endforeach()
message(STATUS "Approved x64 imports: ${imports}")
