# Each reference hash is a full RGB P6 capture from the US Disc 2 Ymir replay.
file(MAKE_DIRECTORY "${TEST_DIR}")
file(STRINGS "${ROOT}/tests/fixtures/finale-frames-usa.csv" images)
list(REMOVE_AT images 0)
set(captures "")
set(ticks "")
foreach(image IN LISTS images)
    string(REPLACE "," ";" fields "${image}")
    list(GET fields 0 tape)
    if(tape STREQUAL TAPE)
        list(GET fields 1 tag)
        string(REGEX REPLACE "^0+" "" tick "${tag}")
        list(APPEND ticks "${tick}")
        list(APPEND captures "${image}")
        file(GLOB stale "${TEST_DIR}/*_FINALE_tick_${tag}.ppm")
        if(stale)
            file(REMOVE ${stale})
        endif()
    endif()
endforeach()
if(NOT captures)
    message(FATAL_ERROR "No Saturn reference frames for ${TAPE}")
endif()
list(JOIN ticks "," capture_ticks)
execute_process(COMMAND "${EXE}"
    "${ROOT}/disco1/Mr. Bones (USA) (Disc 1).cue" "${ROOT}/manifest/versions.txt"
    --disc2 "${ROOT}/disco2/Mr. Bones (USA) (Disc 2).cue"
    --level /27FINALE --finale-replay "${ROOT}/tests/fixtures/${TAPE}"
    --save-dir "${TEST_DIR}" --capture-dir "${TEST_DIR}" --capture-ticks "${capture_ticks}"
    --scale 1 --no-hd-bones --mute
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT rc STREQUAL "0" OR NOT output MATCHES "${EXPECTED_SUMMARY}")
    string(REGEX REPLACE "replay_tick,[^\n]*\n" "" summary "${output}")
    message(FATAL_ERROR "FINALE ${TAPE} (${rc}): ${error}\n${summary}")
endif()

set(last_mask ffff)
set(hits "")
string(REGEX MATCHALL "replay_tick,[0-9]+,[^\r\n]+" rows "${output}")
list(LENGTH rows frames)
if(NOT frames EQUAL 2480)
    message(FATAL_ERROR "Expected 2480 controller updates, got ${frames}")
endif()
foreach(row IN LISTS rows)
    if(NOT row MATCHES "^replay_tick,([0-9]+),[0-9]+,[0-9]+,[0-9]+,[0-9]+,([0-9a-f]+),")
        message(FATAL_ERROR "Invalid FINALE trace: ${row}")
    endif()
    set(tick "${CMAKE_MATCH_1}")
    set(mask "${CMAKE_MATCH_2}")
    if(NOT mask STREQUAL last_mask)
        list(APPEND hits "${tick}/${mask}")
        set(last_mask "${mask}")
    endif()
endforeach()

file(STRINGS "${ROOT}/tests/fixtures/finale-impact-usa.csv" oracle)
list(REMOVE_AT oracle 0)
set(expected "")
foreach(row IN LISTS oracle)
    string(REPLACE "," ";" fields "${row}")
    list(GET fields ${COLUMN} tick)
    list(GET fields 3 mask)
    list(APPEND expected "${tick}/${mask}")
endforeach()
if(NOT hits STREQUAL expected)
    message(FATAL_ERROR "${TAPE} ring impacts (VBlank/mask):\nYmir: ${expected}\nWindows: ${hits}")
endif()

# Match the tick embedded in the capture name, independent of its sequence number.
foreach(image IN LISTS captures)
    string(REPLACE "," ";" fields "${image}")
    list(GET fields 1 tag)
    list(GET fields 2 expected_hash)
    file(GLOB frame "${TEST_DIR}/*_FINALE_tick_${tag}.ppm")
    list(LENGTH frame count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one fresh frame ${tag} for ${TAPE}, found ${count}")
    endif()
    file(SHA256 "${frame}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "FINALE frame ${tag} differs for ${TAPE}: ${actual_hash}, expected ${expected_hash}")
    endif()
endforeach()
